  "quickbird_2003": {
    "acquisition_date": "2003-07-07",
    "legacy_scene_identifier": "20030709_qb",
    "raw_source": "reflectance_rhoTOA_07072003.tif",
    "processing_steps": [
      "1. Reproject/align to canonical EPSG:32633 2 m grid (RBOA_20060408 as reference)",
      "2. Hochberg (2003) glint correction on water pixels (NIR = band 4)",
      "3. Dark Object Subtraction (2nd percentile per band over water pixels)",
      "4. Cross-calibrate to RBOA_20060408 via linear regression on deep-water pseudo-invariant features (PIFs)",
      "5. Apply canonical water mask wm_ALL_f; land = nodata = 0",
      "6. Save 3-band RGB float32, nodata=0, LZW"
    ],
    "radiometric_independence_caveat": "Step 4 anchors the 2003 radiometry to the 2006 QuickBird scene via a linear deep-water PIF regression. The 2003 reflectance product is therefore NOT radiometrically independent of 2006. This must be disclosed in the manuscript Methods: each scene is still classified independently, but the 2003 historical baseline shares a radiometric reference with the 2006 control branch."
  },
